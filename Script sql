  series_realizadas TEXT DEFAULT NULL,
  PRIMARY KEY (id),
  KEY idx_se_sesion (id_sesion),
  CONSTRAINT fk_se_sesion    FOREIGN KEY (id_sesion)    REFERENCES sesiones_entrenamiento(id) ON DELETE CASCADE,
  CONSTRAINT fk_se_ejercicio FOREIGN KEY (id_ejercicio) REFERENCES ejercicios(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

