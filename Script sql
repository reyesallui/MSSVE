-- 9. SESIONES_ENTRENAMIENTO
CREATE TABLE sesiones_entrenamiento (
  id         INT NOT NULL AUTO_INCREMENT,
  id_rutina  INT NOT NULL,
  id_usuario INT NOT NULL,
  fecha      DATE NOT NULL,
  notas      TEXT DEFAULT NULL,
  PRIMARY KEY (id),
  KEY idx_sesion_usuario (id_usuario),
  KEY idx_sesion_fecha   (fecha),
  CONSTRAINT fk_sesion_rutina  FOREIGN KEY (id_rutina)  REFERENCES rutinas(id)  ON DELETE CASCADE,
